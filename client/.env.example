# Clerk Authentication Publishable Key
# Obtain from https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Local development uses the Vite /api proxy. Set this at build time when
# deploying the client separately from the API, e.g.
# VITE_API_BASE_URL=https://your-api.azurewebsites.net/api
VITE_API_BASE_URL=/api

# Keep credentials out of this example file.
