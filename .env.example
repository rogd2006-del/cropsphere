# ============================================================
# FarmDirect Cloud — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-long-random-secret

# ── MongoDB Atlas (DBaaS) ─────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farmdirect?retryWrites=true&w=majority

# ── Cloud Object Storage (PaaS / IaaS) ───────────────────────
# Set STORAGE_PROVIDER to 'azure', 's3', or 'local'
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=farmdirect-images

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=farmdirect-images

# ── Email (optional) ─────────────────────────────────────────
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@farmdirect.example.com

# ── FaaS / Queue ─────────────────────────────────────────────
# Set QUEUE_PROVIDER to 'azure-servicebus', 'rabbitmq', or 'local'
QUEUE_PROVIDER=local
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_NAME=farmdirect-orders

# ── IaaS VM (for cloud dashboard display only) ────────────────
IAAS_PROVIDER=local
VM_HOST=
VM_SSH_USER=
# Never put SSH private key or password here — use SSH agent or key file path

# ── PaaS API Deployment ───────────────────────────────────────
API_BASE_URL=http://localhost:5000

# ── Admin Seed ───────────────────────────────────────────────
# Only used for the dev seed script. Never expose in production.
SEED_ADMIN_EMAIL=admin@farmdirect.dev
SEED_ADMIN_PASSWORD=Admin@FarmDirect2024!

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
